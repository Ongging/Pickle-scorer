# Not used yet — placeholders for when lib/storage.js and lib/auth.js are
# wired up to a real backend. Copy this file to .env.local and fill in
# real values when that day comes; Vite only exposes variables prefixed
# with VITE_ to client code.

# Example if you go with Firebase for auth + cloud storage:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=

# Example if you go with Supabase instead:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
